{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Yarp": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "eTicketing": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "eticketing-identity",
    "Audience": "eticketing-services",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RabbitMq": {
    "Host": "localhost"
  },
  "BlobStorage": {
    "ConnectionString": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION"
  }
}
