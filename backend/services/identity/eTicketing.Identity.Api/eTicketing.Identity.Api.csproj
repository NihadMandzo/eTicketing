<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\eTicketing.Identity.Business\eTicketing.Identity.Business.csproj" />
    <ProjectReference Include="..\eTicketing.Identity.Data\eTicketing.Identity.Data.csproj" />
    <ProjectReference Include="..\..\..\shared\eTicketing.Contracts\eTicketing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\eTicketing.Shared.Auth\eTicketing.Shared.Auth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JwtBearer, OpenApi, HealthChecks.EntityFrameworkCore now come transitively via
         eTicketing.Shared.Auth / eTicketing.Contracts — no need to reference them directly here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
