{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Yarp": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "eTicketing": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CatalogDb": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION"
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION_MIN_32_CHARS",
    "Issuer": "eticketing-identity",
    "Audience": "eticketing-services"
  },
  "BlobStorage": {
    "ConnectionString": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION"
  },
  "RabbitMq": {
    "Host": "localhost"
  },
  "Recommendations": {
    "TrainAtHour": 3,
    "MinInteractionsForPersonalized": 3,
    "MaxCandidates": 500,
    "ModelContainer": "ml-models"
  }
}
