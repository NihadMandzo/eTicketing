<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-eTicketing.PdfGeneration-3de67f64-d765-47d0-b05f-b1cf2cc4014a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied to disk: the runtime image ships only Liberation, and the
         ticket design depends on Manrope's 400-800 weight range. Both faces are OFL 1.1 (licences
         alongside the .ttf files). -->
    <EmbeddedResource Include="Documents\Fonts\*.ttf" />
    <EmbeddedResource Include="Documents\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\eTicketing.Contracts\eTicketing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\eTicketing.Shared.Storage\eTicketing.Shared.Storage.csproj" />
  </ItemGroup>
</Project>
