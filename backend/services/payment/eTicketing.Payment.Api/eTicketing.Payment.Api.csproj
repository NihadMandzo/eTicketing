<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\eTicketing.Payment.Business\eTicketing.Payment.Business.csproj" />
    <ProjectReference Include="..\eTicketing.Payment.Data\eTicketing.Payment.Data.csproj" />
    <ProjectReference Include="..\..\..\shared\eTicketing.Contracts\eTicketing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\eTicketing.Shared.Messaging\eTicketing.Shared.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- No JwtBearer here — intentional. Payment has no public route through the Gateway
         (no exposed docker port), isolation is via network segmentation, not JWT.
         OpenApi/HealthChecks.EntityFrameworkCore come transitively via eTicketing.Contracts. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
