<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- FakeTimeProvider — every "is this ticket valid today" assertion pivots on the current
         date, so the clock is pinned rather than left to whichever day the suite runs on. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\services\ticketing\eTicketing.Ticketing.Business\eTicketing.Ticketing.Business.csproj" />
    <ProjectReference Include="..\..\services\ticketing\eTicketing.Ticketing.Data\eTicketing.Ticketing.Data.csproj" />
    <ProjectReference Include="..\..\shared\eTicketing.Contracts\eTicketing.Contracts.csproj" />
    <!-- Test-only reference: nothing in eTicketing.Ticketing.Business itself depends on
         eTicketing.Payment.Data — this is exclusively so PaymentEnumParityTests can assert
         PaymentChargeStatus stays in lockstep with the real PaymentStatus it's deserialized
         against (see that test for why). -->
    <ProjectReference Include="..\..\services\payment\eTicketing.Payment.Data\eTicketing.Payment.Data.csproj" />
    <!-- Test-only reference, same reasoning as the Payment.Data one above. The AI Uvidi tab
         promises that a dead or slow LLM can never fail a report, and the code that has to keep
         that promise is OpenAiCompatibleNarrativeWriter — which lives in .Api because HTTP wiring
         is a hosting concern. The other HTTP clients there are mocked rather than tested; this one
         is not, because "returns null instead of throwing" is the guarantee itself.
         RedisSectorCapacityLock is the second class here for the same kind of reason: it owns the
         holdinfo string that records a hold's owner, every ownership check in SectorService and
         PurchaseService reads that string, and getting its format wrong fails open — see
         Infrastructure/RedisSectorCapacityLockTests. -->
    <ProjectReference Include="..\..\services\ticketing\eTicketing.Ticketing.Api\eTicketing.Ticketing.Api.csproj" />
  </ItemGroup>

</Project>
