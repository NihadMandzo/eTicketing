{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION_MIN_32_CHARS"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "organizations-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/organizations/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "admins-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/admins/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "recommendations-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/recommendations/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "sectors-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/sectors/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "purchases-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/purchases/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "tickets-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/tickets/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "ticket-print-batches-route": {
        "ClusterId": "ticketing-print-cluster",
        "Match": { "Path": "/api/ticket-print-batches/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      // The plain ticketing-cluster, not the print one: a report aggregates a bounded range
      // (366 days max) and answers well inside the default timeout, unlike a multi-thousand-ticket
      // print render.
      "reports-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/reports/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      // Back-office CRUD for gate devices — organizer-authenticated like any other admin route.
      // Distinct from /api/gate below, which is the device-authenticated pair the scanner calls.
      "gate-devices-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/gate-devices/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "gate-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/gate/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "subscriptions-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/subscriptions/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      // The ONLY publicly routed path on eTicketing.Payment, and deliberately an EXACT path rather
      // than a "/api/payments/{**catch-all}" like every other route here: a catch-all would also
      // publish /payments/intents, /payments/capture and /payments/subscriptions/*, which are
      // internal calls from eTicketing.Ticketing and must stay unreachable from the internet.
      //
      // It carries no auth because a payment provider has neither a session cookie nor a bearer
      // token; the request authenticates itself with a signature over the raw body, which YARP
      // forwards untouched (no body transform is configured anywhere in this file).
      "payment-webhook-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payments/webhook", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "d1": { "Address": "http://identity-service:8080/" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "d1": { "Address": "http://catalog-service:8080/" }
        }
      },
      // ticketing-print-cluster below duplicates this same destination address to carry its own
      // longer ActivityTimeout — if this address ever changes, update both clusters together.
      "ticketing-cluster": {
        "Destinations": {
          "d1": { "Address": "http://ticketing-service:8080/" }
        }
      },
      "ticketing-print-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        },
        "Destinations": {
          "d1": { "Address": "http://ticketing-service:8080/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "d1": { "Address": "http://payment-service:8080/" }
        }
      }
    }
  }
}
