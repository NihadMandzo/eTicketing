{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "REPLACE_WITH_ENV_VARIABLE_IN_PRODUCTION_MIN_32_CHARS"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "organizations-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/organizations/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "admins-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/admins/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "categories-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "sectors-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/sectors/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "purchases-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/purchases/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "tickets-route": {
        "ClusterId": "ticketing-cluster",
        "Match": { "Path": "/api/tickets/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "ticket-print-batches-route": {
        "ClusterId": "ticketing-print-cluster",
        "Match": { "Path": "/api/ticket-print-batches/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "d1": { "Address": "http://identity-service:8080/" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "d1": { "Address": "http://catalog-service:8080/" }
        }
      },
      "ticketing-cluster": {
        "Destinations": {
          "d1": { "Address": "http://ticketing-service:8080/" }
        }
      },
      "ticketing-print-cluster": {
        // A separate cluster, same destination, purely so this one route can carry its own
        // timeout — a print batch can legitimately take a while to answer (a several-hundred-page
        // download streaming out, or a status poll landing while a huge render is mid-flight), and
        // that must never shorten the purchase critical path's own timeout on ticketing-cluster.
        // The default 100s YARP ActivityTimeout is the actual purchase-path budget; this is not.
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        },
        "Destinations": {
          "d1": { "Address": "http://ticketing-service:8080/" }
        }
      }
    }
  }
}
