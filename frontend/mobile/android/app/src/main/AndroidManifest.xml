<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed in every build type (the Flutter-generated debug/profile
         manifests only cover dev tooling): the app talks to the Gateway over
         the network on every screen. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="eKarta"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <!-- The backend (Gateway) is plain HTTP with no TLS termination in
             this dev/thesis setup — see ApiConfig.baseUrl, which always
             builds an http:// URL (10.0.2.2 emulator alias, or a LAN IP
             passed via a dart-define for a real device). Android blocks
             cleartext traffic by default since API 28, so without this flag
             every request is killed by the OS before it leaves the device,
             surfacing as a generic "cannot load" error with nothing in the
             Gateway logs. Revisit this once the Gateway terminates TLS. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Required by google_maps_flutter (ProductLocationMap, shown on all 3 product detail
             screens). Value is a Gradle manifest placeholder, not a literal key — see
             android/app/build.gradle.kts for where ${mapsApiKey} is resolved from (env var or
             local.properties, never committed). Empty/unset means the map fails to load tiles
             until a real key is provisioned. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
