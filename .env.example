# =============================================================================
# eTicketing — copy to .env and fill in.   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# =============================================================================

# --- SQL Server -------------------------------------------------------------
SA_PASSWORD=ChangeMe_Str0ng!Passw0rd
SQLSERVER_PORT=1433

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_MANAGEMENT_PORT=15672

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Brevo (notifications service — transactional email) --------------------
# https://app.brevo.com  →  SMTP & API  →  API keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=eKarta

# --- JWT / session ----------------------------------------------------------
# Minimum 32 characters — the auth extension refuses to start with anything shorter.
JWT_SIGNING_KEY=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- Azure Blob Storage (ticket PDFs, ML model snapshots) -------------------
AZURE_STORAGE_CONNECTION_STRING=

# --- Gateway / clients ------------------------------------------------------
GATEWAY_PORT=5000
CORS_ALLOWED_ORIGIN=http://localhost:4200
WEB_PORT=4200
WEB_API_BASE_URL=http://localhost:5000/api
# 10.0.2.2 is the Android emulator's alias for the host's localhost — don't "fix" it to localhost.
MOBILE_API_BASE_URL=http://10.0.2.2:5000/api/
MOBILE_BUILD_MODE=release
DESKTOP_API_BASE_URL=http://localhost:5000/api/
DESKTOP_BUILD_MODE=release

# --- Gate / QR --------------------------------------------------------------
QR_SIGNING_KEY=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARS

# --- Support contact printed on tickets -------------------------------------
SUPPORT_EMAIL=podrska@ekarta.ba
SUPPORT_PHONE=

# --- Payments ---------------------------------------------------------------
# "Mock" or "Stripe". Mock is the offline gateway: a card whose last four digits are "0000"
# declines, anything else succeeds, and no Stripe account or network access is needed. It is also
# the documented rollback — flipping this back to Mock and restarting payment-service returns the
# whole stack to the pre-Stripe behaviour with NO frontend rebuild, because the provider name is
# returned to the clients on every payment-intent response.
PAYMENT_PROVIDER=Mock

# https://dashboard.stripe.com/test/apikeys  (test mode — keys start sk_test_ / pk_test_)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Stripe cannot reach localhost, so for local development run:
#   stripe listen --forward-to http://localhost:5000/api/payments/webhook
# and paste the whsec_... value IT PRINTS here — not the one shown in the dashboard —
# then: docker compose up -d payment-service
STRIPE_WEBHOOK_SECRET=

# ISO-4217, lowercase. Prices display as KM everywhere, but a Stripe test account can only present
# the currencies its country allows and BAM is unavailable on most of them. Check yours with:
#   stripe payment_intents create --amount 1000 --currency bam
STRIPE_CURRENCY=eur

# --- AI Uvidi: optional LLM summary on the Izvještaji insights tab ----------
# Leave PROVIDER as None to disable it entirely; the ML.NET analysis works without it.
INSIGHTS_NARRATIVE_PROVIDER=None
INSIGHTS_NARRATIVE_BASE_URL=http://ollama:11434/v1
INSIGHTS_NARRATIVE_MODEL=llama3.2:3b
INSIGHTS_NARRATIVE_API_KEY=
