# =============================================================================
# eTicketing — root environment file template
#
#   1. copy this file:      cp .env.example .env      (Windows: copy .env.example .env)
#   2. fill in the three values marked REQUIRED below (Azure Storage + Brevo)
#   3. run:                 docker compose up -d --build
#
# Everything else already holds a working local-development default.
# .env is git-ignored. Never commit real keys, and never reuse the dev keys below in a
# deployment: they are public in this repository.
# =============================================================================

# --- Azure Blob Storage (REQUIRED) -------------------------------------------
# Product images, organization logos, category icons, ticket PDFs and the recommendation model.
# Portal -> Storage account -> Access keys -> Connection string. Needs "Allow Blob public access".
AZURE_STORAGE_CONNECTION_STRING=

# --- Brevo transactional email (REQUIRED) ------------------------------------
# Verification codes, ticket emails and notices.
# https://app.brevo.com -> SMTP & API -> API Keys. The sender must be verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=eKarta

# --- Local development defaults (work as-is) ---------------------------------
# SQL Server sa password. Must meet SQL Server complexity rules.
SA_PASSWORD=Eticketing_Dev_Passw0rd!
# Session token signing key, shared by every service. Minimum 32 characters.
JWT_SIGNING_KEY=dev-only-jwt-signing-key-change-me-0123456789abcdef
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
# Signs the QR code on every ticket. Changing it invalidates QR codes already issued.
QR_SIGNING_KEY=dev-only-qr-signing-key-change-me-0123456789abcdef

# --- Ports and URLs -----------------------------------------------------------
GATEWAY_PORT=5000
WEB_PORT=4200
SQLSERVER_PORT=1433
REDIS_PORT=6379
RABBITMQ_MANAGEMENT_PORT=15672
CORS_ALLOWED_ORIGIN=http://localhost:4200

# Read by the Angular build (@ngx-env/builder) and baked into the bundle. Public values only.
NG_APP_API_BASE_URL=http://localhost:5000/api
# Optional. Empty renders a labelled placeholder instead of the map.
NG_APP_GOOGLE_MAPS_API_KEY=

# Baked into the Flutter builds (docker compose --profile build run --rm mobile-build / desktop-build).
# 10.0.2.2 is the Android emulator's alias for the host's localhost. Use your LAN IP for a real phone.
MOBILE_API_BASE_URL=http://10.0.2.2:5000/api/
MOBILE_BUILD_MODE=release
DESKTOP_API_BASE_URL=http://localhost:5000/api/
DESKTOP_BUILD_MODE=release

# --- Support contact printed on ticket PDFs -----------------------------------
SUPPORT_EMAIL=podrska@ekarta.ba
SUPPORT_PHONE=

# --- Payments -----------------------------------------------------------------
# Mock is the offline gateway: no Stripe account needed, a card ending in 0000 is declined.
# For Stripe test mode set PAYMENT_PROVIDER=Stripe and fill in the three keys (see README).
PAYMENT_PROVIDER=Mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur

# --- AI Uvidi summary (optional) ----------------------------------------------
# None disables the LLM summary. The ML.NET forecast, anomalies and segments work regardless.
INSIGHTS_NARRATIVE_PROVIDER=None
INSIGHTS_NARRATIVE_BASE_URL=http://ollama:11434/v1
INSIGHTS_NARRATIVE_MODEL=llama3.2:3b
INSIGHTS_NARRATIVE_API_KEY=
